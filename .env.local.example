# Required: your Groq API key
# Create one in the Groq console
GROQ_API_KEY=your_api_key_here

# Comma-separated list of allowed request origins for /api/analyze.
# Add your production domain (e.g. https://yourapp.example.com) for production.
ALLOWED_ORIGINS=http://localhost:7001

# Maximum requests per IP per minute to /api/analyze.
# Production uses a shared Upstash Redis counter; local dev/test falls back to
# an in-memory limiter.
RATE_LIMIT_PER_MIN=20

# Required in production: Upstash Redis REST credentials used for distributed
# rate limiting across replicas.
# Examples come from the Upstash console:
# UPSTASH_REDIS_REST_URL=https://<region>-<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Required in production: the request header that carries the authoritative
# client IP, as injected by a trusted reverse proxy (for example ALB or nginx).
# The proxy MUST strip inbound copies of this header from untrusted clients.
# Example: TRUSTED_IP_HEADER=x-client-ip
# TRUSTED_IP_HEADER=
