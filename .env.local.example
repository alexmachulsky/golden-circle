# Required: your OpenRouter API key (the app calls OpenRouter's
# OpenAI-compatible API; see app/api/analyze/route.ts).
# Create one at https://openrouter.ai/keys
# Production Docker deployments should mount OPENROUTER_API_KEY via
# /run/secrets/openrouter_api_key (set OPENROUTER_API_KEY_FILE to that path).
OPENROUTER_API_KEY=your_api_key_here

# Comma-separated list of allowed request origins for /api/analyze.
# Add your production domain (e.g. https://yourapp.example.com) for production.
ALLOWED_ORIGINS=http://localhost:7001

# Maximum requests per IP per minute to /api/analyze.
# Production uses a shared Upstash Redis counter; local dev/test falls back to
# an in-memory limiter.
RATE_LIMIT_PER_MIN=20

# Deployment mode for production builds.
# Set DEPLOYMENT_MODE=local for a single-container Docker run with no reverse proxy.
# Leave unset, or set to public, for internet-facing deployments behind a trusted proxy.
# DEPLOYMENT_MODE=

# Required in production: Upstash Redis REST credentials used for distributed
# rate limiting across replicas.
# In Docker production, mount UPSTASH_REDIS_REST_TOKEN via
# /run/secrets/upstash_redis_rest_token instead of storing it in this file.
# Examples come from the Upstash console:
# UPSTASH_REDIS_REST_URL=https://<region>-<name>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# UPSTASH_REDIS_REST_TOKEN=

# Required in production: the request header that carries the authoritative
# client IP, as injected by a trusted reverse proxy (for example ALB or nginx).
# The proxy MUST strip inbound copies of this header from untrusted clients.
# Example: TRUSTED_IP_HEADER=x-client-ip
# TRUSTED_IP_HEADER=

# Required in production: Cloudflare Turnstile configuration for server-verified
# human checks on /api/analyze.
# TURNSTILE_SITE_KEY=your_public_site_key
# For local development only:
# TURNSTILE_SECRET_KEY=your_secret_key
# Production Docker deployments should mount TURNSTILE_SECRET_KEY via
# /run/secrets/turnstile_secret_key.
