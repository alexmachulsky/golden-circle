# Version control
.git
.gitignore

# Dependencies (reinstalled inside image)
node_modules

# Next.js build output (rebuilt inside image)
.next

# Local env files — injected at runtime via docker-compose, never baked in
.env
.env.*
!.env.local.example

# Secret files — mounted at runtime via Docker secrets, must never be baked into image layers
secrets

# Dev/editor artifacts
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# CI/CD & docs
.github
README.md
AGENTS.md
CLAUDE.md

# Misc
coverage
*.tsbuildinfo
