# Packages vendored inside next/dist/compiled/ are baked into the Next.js
# distribution bundle and cannot be upgraded independently via npm. Fixes
# require an upstream Next.js release.
#
# Each suppression below is a TIME-BOUNDED exception. Format:
#   <CVE>  expires=<YYYY-MM-DD>  owner=<github-handle>  upstream=<tracking-url>
# CI flags entries within 14 days of expiry; review on every Next.js bump.
#
# Default expiry policy: re-check at the next Next.js minor release or
# 6 months from the date of the suppression, whichever comes first.

# cross-spawn (next/dist/compiled/cross-spawn)
CVE-2024-21538  expires=2026-10-27  owner=alexmachulsky  upstream=https://github.com/vercel/next.js/issues?q=cross-spawn

